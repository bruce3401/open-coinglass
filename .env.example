# ---------------------------------------------------------------------------
# open-coinglass configuration. Copy to `.env` and adjust.
#   cp .env.example .env
# All values below are defaults; every line is optional.
# ---------------------------------------------------------------------------

# Scrape intervals (seconds)
COINGLASS_SCRAPE_INTERVAL=300
COINGECKO_SCRAPE_INTERVAL=300

# CoinGecko (optional demo API key; the service works without one, just slower/rate-limited)
COINGECKO_API_KEY=
COINGECKO_TOP_N=250

# Coins to collect in-depth detail for (CoinGlass + CoinGecko merged)
DETAIL_COINS=BTC,ETH,SOL

# Optional HTTP/HTTPS proxy for all outbound scraping, e.g. http://proxy.example.com:3128
# Leave empty to connect directly.
HTTP_PROXY=

# How many days of historical rows to keep before cleanup
RETENTION_DAYS=30

# Service
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=INFO
DB_PATH=data/coininfo.db

# Optional API gate: if set, every /api/* request must send header `X-API-Key: <value>`.
# Leave empty to expose the API (and dashboard) without authentication.
API_KEY=
